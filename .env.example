# ==============================================================================
# DTF AUTO PRO — Configurações de Ambiente para Produção (SaaS Production)
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL / Supabase)
# Connection String com Pooler ou Direct Connection do Supabase
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres?sslmode=require"
# POSTGRES_URL="..."

# 2. STORAGE PRIVADO EM NUVEM (Supabase Storage)
# Crie os buckets privados: 'arts' e 'queues' no painel do Supabase
SUPABASE_URL="https://[SEU_PROJETO].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Chave restrita ao backend

# 3. AUTENTICAÇÃO E SEGURANÇA (JWT & Cookies)
JWT_SECRET="gere_uma_chave_secreta_jwt_longa_e_aleatoria_com_openssl_rand_hex_32"
NEXTAUTH_SECRET="sua_chave_secreta_aqui"
NEXTAUTH_URL="https://seu-dominio-oficial.com.br"

# 4. GATEWAY DE PAGAMENTO ASAAS (Pix Automático R$ 75/mês)
# Obtenha sua API Key em: Configurações da Conta > Integrações no painel do Asaas
ASAAS_API_KEY="$aact_sua_api_key_do_asaas_aqui"
ASAAS_ENVIRONMENT="sandbox" # Altere para "production" ao publicar para clientes reais
ASAAS_WEBHOOK_SECRET="seu_token_secreto_definido_no_webhook_do_asaas"

# 5. CONFIGURAÇÕES DO SERVIDOR
NODE_ENV="production"
PORT=3000
